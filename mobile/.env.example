# Адрес API бэкенда. Для эмулятора Android используйте http://10.0.2.2:8000/api/v1,
# для телефона в той же Wi-Fi сети — IP компьютера, например http://192.168.1.10:8000/api/v1.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# Показать вход по номеру без Telegram (только для разработки, бэкенд с DEV_LOGIN_ENABLED=1).
EXPO_PUBLIC_DEV_LOGIN=1
