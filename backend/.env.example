# Скопируйте в .env и заполните. Файл .env не коммитится.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8081

POSTGRES_DB=menu
POSTGRES_USER=menu
POSTGRES_PASSWORD=menu
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Telegram-бот для входа (создаётся через @BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Любая случайная строка: Telegram присылает её в заголовке вебхука.
TELEGRAM_WEBHOOK_SECRET=
# Куда ведёт кнопка «Вернуться в приложение» в боте (deep link приложения).
APP_RETURN_URL=

# Вход по номеру без Telegram. Только для разработки! В проде — 0.
DEV_LOGIN_ENABLED=0

# Пуш-уведомления: log (только лог) или fcm (нужен firebase-admin и ключ сервисного аккаунта).
PUSH_BACKEND=log
FCM_CREDENTIALS_FILE=
